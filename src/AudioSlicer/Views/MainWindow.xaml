<Window x:Class="AudioSlicer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioSlicer.Views"
        Title="Audio Slicer"
        Width="1480"
        Height="920"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenMediaCommand}" />
    <KeyBinding Key="Space" Command="{Binding Player.TogglePlaybackCommand}" />
    <KeyBinding Key="Left" Command="{Binding StepBackwardCommand}" />
    <KeyBinding Key="Right" Command="{Binding StepForwardCommand}" />
    <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding FineStepBackwardCommand}" />
    <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding FineStepForwardCommand}" />
    <KeyBinding Key="OemOpenBrackets" Command="{Binding SetSelectionStartCommand}" />
    <KeyBinding Key="OemCloseBrackets" Command="{Binding SetSelectionEndCommand}" />
    <KeyBinding Key="L" Command="{Binding ToggleLoopCommand}" />
    <KeyBinding Key="Home" Command="{Binding GoSelectionStartCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Key="Enter" Command="{Binding AddSegmentCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedSegmentsCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllSegmentsCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveProjectCommand}" />
  </Window.InputBindings>

  <Grid Background="{StaticResource WindowGradientBrush}" ClipToBounds="True">
    <Ellipse Width="360"
             Height="360"
             Margin="-150,-180,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Fill="#C9C3FF"
             Opacity="0.22"
             IsHitTestVisible="False" />
    <Ellipse Width="300"
             Height="300"
             Margin="0,60,-140,0"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Fill="#BDEFF5"
             Opacity="0.28"
             IsHitTestVisible="False" />

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Margin="18,12,18,0"
              Padding="16,0"
              Background="#E6FCFBFF"
              BorderBrush="#CCD5D0EB"
              BorderThickness="1"
              CornerRadius="18">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.1" ShadowDepth="4" Color="#756E9C" />
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="42" Height="42" Background="{StaticResource PrimaryGradientBrush}" CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="22"
                         Foreground="White"
                         Text="✦" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="19" FontWeight="Bold" Text="Audio Slicer" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="视频辅助音频切片" />
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="2"
                  MaxWidth="560"
                  Padding="13,7"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="#EDEAF8"
                  CornerRadius="11">
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding MediaFileName}"
                       TextTrimming="CharacterEllipsis" />
          </Border>

          <Button Grid.Column="3"
                  MinWidth="138"
                  Command="{Binding OpenMediaCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  ToolTip="导入视频（Ctrl+O）">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0,0,9,0" FontSize="17" Foreground="White" Text="＋" />
              <TextBlock FontSize="13" Foreground="White" Text="导入视频" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18,14,18,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="650" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="370" MinWidth="310" MaxWidth="540" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="300" />
            <RowDefinition Height="12" />
            <RowDefinition Height="2*" MinHeight="240" />
          </Grid.RowDefinitions>

          <views:VideoPlayerView Grid.Row="0" DataContext="{Binding Player}" />
          <GridSplitter Grid.Row="1"
                        Height="12"
                        HorizontalAlignment="Stretch"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext" />
          <views:WaveformView Grid.Row="2" />
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="12"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />

        <views:SegmentListView x:Name="SegmentPanel" Grid.Column="2" />
      </Grid>

      <Grid Grid.Row="2" Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="9"
                Height="9"
                Margin="0,0,9,0"
                Background="{StaticResource SuccessBrush}"
                CornerRadius="5" />
        <TextBlock Grid.Column="1"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="{Binding StatusMessage}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}" Text="◇" />
          <TextBlock FontSize="12"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="原始媒体安全只读" />
        </StackPanel>
        <ProgressBar Grid.Column="1"
                     Width="180"
                     Height="3"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Maximum="1"
                     Value="{Binding OperationProgress, Mode=OneWay}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
