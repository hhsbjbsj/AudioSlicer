<Window x:Class="AudioSlicer.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出音频"
        Width="520"
        Height="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="导出设置" />
    <Border Grid.Row="1"
            Margin="0,18,0,18"
            Padding="18"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="7">
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="导出功能将在 Phase 7 启用。默认设置已按 WAV / PCM 16-bit / Mono / 48000 Hz 建模。"
                 TextWrapping="Wrap" />
    </Border>
    <Button Grid.Row="2"
            Width="90"
            HorizontalAlignment="Right"
            Click="OnCloseClick"
            Content="关闭" />
  </Grid>
</Window>

