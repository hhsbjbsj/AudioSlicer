<UserControl x:Class="AudioSlicer.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="7">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="88" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Padding="13,0"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="视频预览" />
          <TextBlock HorizontalAlignment="Right"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="LibVLC" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Background="#050607">
        <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="40"
                     Foreground="#435064"
                     Text="▶" />
          <TextBlock Margin="0,8,0,0"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="导入视频后在此预览" />
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              Padding="12,9"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     Width="78"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="{StaticResource PrimaryBrush}"
                     Text="{Binding CurrentTimeText}" />
          <Slider x:Name="SeekSlider"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="8,0"
                  IsEnabled="{Binding HasMedia}"
                  Maximum="{Binding DurationMilliseconds}"
                  Minimum="0"
                  primitives:Thumb.DragCompleted="OnSeekDragCompleted"
                  primitives:Thumb.DragStarted="OnSeekDragStarted"
                  Value="{Binding CurrentTimeMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="0"
                     Grid.Column="2"
                     Width="78"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding DurationText}"
                     TextAlignment="Right" />

          <StackPanel Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Margin="0,8,0,0"
                      Orientation="Horizontal">
            <Button MinWidth="82"
                    Command="{Binding TogglePlaybackCommand}"
                    Content="{Binding PlayPauseLabel}"
                    ToolTip="播放/暂停（Space）" />
            <Button Margin="8,0,0,0"
                    Command="{Binding StopCommand}"
                    Content="停止" />
            <TextBlock Margin="22,0,8,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="音量" />
            <Slider Width="108"
                    IsMoveToPointEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="22,0,8,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="倍速" />
            <ComboBox Width="84"
                      ItemsSource="{Binding PlaybackRates}"
                      SelectedItem="{Binding SelectedPlaybackRate, Mode=TwoWay}"
                      ToolTip="播放速度">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="#111318" Text="{Binding StringFormat={}{0:0.##}×}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>

