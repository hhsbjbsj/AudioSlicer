<UserControl x:Class="AudioSlicer.Views.SegmentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AudioSlicer.ViewModels">
  <Border Style="{StaticResource CardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66" />
        <RowDefinition Height="92" />
        <RowDefinition Height="*" />
        <RowDefinition Height="88" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="16" FontWeight="Bold" Text="音频收藏夹" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="11"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="每个条目都是可播放的独立文件" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="10,5"
                VerticalAlignment="Center"
                Background="#ECE9FF"
                CornerRadius="12">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryBrush}"
                     Text="{Binding Segments.Segments.Count, StringFormat={}{0} 个}" />
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Margin="14,0,14,12"
              Padding="10"
              Background="{StaticResource SoftAccentGradientBrush}"
              CornerRadius="15">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="4,0,12,0" VerticalAlignment="Center">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="选好波形区间了吗？" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="按 Enter 也可以立即生成" />
          </StackPanel>
          <Button Grid.Column="1"
                  MinWidth="132"
                  Padding="14,10"
                  Command="{Binding AddSegmentCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  ToolTip="把当前波形选区生成独立 WAV">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0,0,7,0" FontSize="15" Foreground="White" Text="✦" />
              <TextBlock Foreground="White" Text="生成选区音频" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="58" Height="58" Background="#ECE9FF" CornerRadius="22">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="26"
                       Foreground="{StaticResource PrimaryBrush}"
                       Text="♫" />
          </Border>
          <TextBlock Margin="0,14,0,0"
                     HorizontalAlignment="Center"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Text="这里还没有音频" />
          <TextBlock Margin="0,5,0,0"
                     HorizontalAlignment="Center"
                     FontSize="11"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="在波形上拖出区间，然后点击生成" />
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Segments.Segments.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
        </StackPanel>

        <ListBox x:Name="SegmentList"
                 Margin="12,0"
                 ItemsSource="{Binding Segments.Segments}"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnItemDoubleClick"
                 SelectionMode="Extended"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,8" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="IsSelected" Value="{Binding IsListSelected, Mode=TwoWay}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SegmentItemViewModel}">
              <Border Padding="12"
                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      BorderThickness="1"
                      CornerRadius="15">
                <Border.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="删除这一段"
                              InputGestureText="Ctrl+Z 可撤销"
                              Command="{Binding PlacementTarget.Tag.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8F7FC" />
                    <Setter Property="BorderBrush" Value="#E2DEEF" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="#F0EEFF" />
                        <Setter Property="BorderBrush" Value="#958DFF" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox Grid.Row="0"
                            Grid.RowSpan="4"
                            Grid.Column="0"
                            Margin="0,2,10,0"
                            VerticalAlignment="Top"
                            IsChecked="{Binding IsExportSelected}"
                            ToolTip="勾选后可加入 ZIP" />
                  <Border Grid.Row="0"
                          Grid.Column="1"
                          Width="34"
                          Height="24"
                          HorizontalAlignment="Left"
                          Background="#E7E3FF"
                          CornerRadius="8">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding NumberText}" />
                  </Border>
                  <TextBlock Grid.Row="0"
                             Grid.Column="2"
                             Margin="8,0,0,0"
                             FontSize="11"
                             Foreground="{StaticResource MutedTextBrush}"
                             Text="{Binding DurationText}" />

                  <TextBox x:Name="NameEditor"
                           Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           Padding="0"
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           GotKeyboardFocus="OnNameGotFocus"
                           LostKeyboardFocus="OnNameLostFocus" />

                  <TextBlock Grid.Row="2"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Margin="0,7,0,0"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="{StaticResource MutedTextBrush}"
                             Text="{Binding RangeText}" />

                  <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource SuccessBrush}" />
                      <TextBlock FontSize="11"
                                 Foreground="{StaticResource SuccessBrush}"
                                 Text="{Binding FileStatus}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding AudioFilePath}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="92"
                            Padding="11,5"
                            Command="{Binding DataContext.PlayTaskAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="▶  播放" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Row="3"
              Margin="14,10,14,14"
              Padding="12,10"
              Background="#F2F0FA"
              CornerRadius="15">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="管理已勾选音频" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="10"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="可以打包，也可以一键删除" />
          </StackPanel>
          <Button Grid.Column="1"
                  MinWidth="106"
                  Foreground="#D65372"
                  Background="#FFF0F4"
                  BorderBrush="#F7CCD8"
                  Command="{Binding DeleteCheckedSegmentsCommand}"
                  Content="删除勾选" />
          <Button Grid.Column="3"
                  MinWidth="116"
                  Command="{Binding PackageTaskAudioCommand}"
                  Content="打包 ZIP" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
