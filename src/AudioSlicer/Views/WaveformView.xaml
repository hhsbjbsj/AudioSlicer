<UserControl x:Class="AudioSlicer.Views.WaveformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:waveform="clr-namespace:AudioSlicer.Waveform">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="48" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Padding="13,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="音频波形与时间轴" />
          <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" Text="滚轮缩放 · Shift+滚轮平移 · 右键拖动画布" />
        </Grid>
      </Border>
      <waveform:WaveformEditorControl Grid.Row="1"
                                      Margin="8"
                                      Waveform="{Binding Waveform.Data}"
                                      CurrentTimeSeconds="{Binding Player.CurrentTimeSeconds, Mode=TwoWay}"
                                      SelectionStartSeconds="{Binding Waveform.SelectionStartSeconds, Mode=TwoWay}"
                                      SelectionEndSeconds="{Binding Waveform.SelectionEndSeconds, Mode=TwoWay}"
                                      ViewportStartSeconds="{Binding Waveform.ViewportStartSeconds, Mode=TwoWay}"
                                      ViewportDurationSeconds="{Binding Waveform.ViewportDurationSeconds, Mode=TwoWay}" />
      <Border Grid.Row="2" Padding="10,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="开始" />
          <TextBox Width="108" Margin="7,0,14,0" Text="{Binding Waveform.SelectionStartText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="结束" />
          <TextBox Width="108" Margin="7,0,14,0" Text="{Binding Waveform.SelectionEndText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="长度" />
          <TextBlock Width="92" Margin="7,0,14,0" FontFamily="Consolas" Text="{Binding Waveform.SelectionDurationText}" />
          <Button Padding="10,4" Command="{Binding ApplySelectionTimesCommand}" Content="应用时间" />
          <Button Margin="7,0,0,0" Padding="10,4" Command="{Binding ToggleLoopCommand}" Content="循环选区 (L)" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
